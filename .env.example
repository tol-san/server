# Project Settings
PROJECT_NAME="GenZ Media API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="genz_media"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/genz_media"

# Security / JWT
SECRET_KEY="development-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL="redis://localhost:6379/0"

# MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="genz-media"
MINIO_SECURE=false
MINIO_PUBLIC_URL="http://localhost:9000"

# Meilisearch
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_MASTER_KEY="meilisearch_master_key_change_in_production"

# LiveKit (WebRTC Media Streaming)
# For local development with Docker: ws://localhost:7880 with devkey/secret
# For production: Obtain from https://cloud.livekit.io
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# WebSocket & Chat Settings
WS_TICKET_TTL_SECONDS=60
CHAT_RATE_LIMIT_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=10

# Workers & Outbox Settings
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
WORKER_MAX_RETRIES=3
DEAD_LETTER_AFTER_RETRIES=3
WORKER_BLOCK_MS=2000

# Observability
ENABLE_METRICS=true
LOG_FORMAT="json"

